SPRING_PROFILES_ACTIVE=dev

# PostgreSQL with the pgvector extension enabled.
DB_URL=jdbc:postgresql://localhost:5432/parking_reservation
DB_USERNAME=postgres
DB_PASSWORD=
PGVECTOR_ENABLED=true
PGVECTOR_TABLE_NAME=vector_store
EMBEDDING_DIMENSIONS=1536

# OpenAI-compatible chat and embedding provider.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Langfuse OTLP trace ingestion.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_OTLP_ENDPOINT=http://localhost:3000/api/public/otel/v1/traces
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional personal MCP Antigravity Streamable HTTP endpoint.
MCP_ANTIGRAVITY_ENABLED=false
MCP_ANTIGRAVITY_ENDPOINT=
MCP_ANTIGRAVITY_TOKEN=
